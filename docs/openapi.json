        "responses": {
          "204": {
            "description": "Stored. Any 2xx works; the body is ignored."
          },
          "400": {
            "description": "Malformed batch. Reported to the script's onError; the batch is dropped."
          },
          "default": {
            "description": "Any other non-2xx is reported to the script's onError and the batch is dropped."
          }
        }
      }
    },
    "/rest/v1/{table}": {
      "post": {
        "tags": [
          "supabase"
        ],
        "operationId": "insertEventRows",
        "summary": "Insert flat event rows into Supabase",
        "description": "Sent by `supabase({ url, key, table })`. Each event is flattened by `toRow()` into a row of the table in `schema/postgres.sql`, whose row-level security lets the public key insert and nothing else.",
        "security": [
          {
            "supabaseKey": []
          }
        ],
        "parameters": [
          {
            "name": "table",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "default": "analy_events"
            }
          },
          {
            "name": "prefer",
            "in": "header",
            "required": true,
            "schema": {
              "const": "return=minimal"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/components/schemas/EventRow"
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Rows inserted."
          },
          "400": {
            "description": "Rows did not match the table. Reported to the script's onError; the batch is dropped."
          },
          "default": {
            "description": "PostgREST error. Reported to the script's onError; the batch is dropped."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "supabaseKey": {
        "type": "apiKey",
        "in": "header",
        "name": "apikey",
        "description": "Supabase anon or publishable key. Legacy JWT anon keys are also sent as `Authorization: Bearer <key>`."
      }
    },
