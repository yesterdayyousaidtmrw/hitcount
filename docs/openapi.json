{
  "openapi": "3.1.0",
  "info": {
    "title": "analy collector API",
    "version": "1.0.0",
    "summary": "What an endpoint receives from the analy script.",
    "description": "analy runs in the browser and hosts no API of its own. This spec describes the requests its sinks\nsend, so you can build, generate or validate a collector for them. It is generated from the source\ntypes by scripts/schema.mjs on every build.\n\n- `POST /collect` is whatever URL you give the `http()` sink (`data-endpoint` on the script tag).\n- `POST /rest/v1/{table}` is what the `supabase()` sink sends to Supabase's REST API.\n\nDelivery is at most once: failed batches are not retried. Every event has a unique `id`, so inserts\ncan be made idempotent on it.",
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    }
  },
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "servers": [
    {
      "url": "https://{host}",
      "description": "Your collector",
      "variables": {
        "host": {
          "default": "collect.your-site",
          "description": "Wherever you host the collector."
        }
      }
    }
  ],
  "tags": [
    {
      "name": "collect",
      "description": "The http() sink"
    },
    {
      "name": "supabase",
      "description": "The supabase() sink"
    }
  ],
  "paths": {
    "/collect": {
      "post": {
        "tags": [
          "collect"
        ],
        "operationId": "collectEvents",
        "summary": "Receive a batch of events",
        "security": [],
        "description": "One request per batch: up to `batchSize` events (default 10), sent when the batch fills, after\n`flushIntervalMs` (default 5000) or when the page is hidden.\n\nWithout custom headers the body is `text/plain`, which is CORS-safelisted: no preflight, and\n`navigator.sendBeacon` can deliver it while the page unloads. Parse the body as JSON whatever the\ncontent type says. With `http(url, { headers })` the body is `application/json` and the browser\nsends a CORS preflight first. A `format()` option replaces the body with your own shape.",
        "requestBody": {
          "required": true,
          "content": {
            "text/plain": {
              "schema": {
                "type": "string",
                "contentMediaType": "application/json",
                "contentSchema": {
                  "$ref": "#/components/schemas/Batch"
                }
              }
            },
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Batch"
              },
