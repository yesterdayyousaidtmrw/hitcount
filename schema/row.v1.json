{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hitcount:schema:row:v1",
  "title": "hitcount event row v1",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string"
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "site": {
      "type": [
        "string",
        "null"
      ]
    },
    "visitor_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "session_id": {
      "type": "string",
      "format": "uuid"
    },
    "user_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "page_view_id": {
      "type": "string",
      "format": "uuid"
    },
    "url": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "referrer": {
      "type": [
        "string",
        "null"
      ]
    },
    "language": {
      "type": "string"
    },
    "timezone": {
      "type": "string"
    },
    "screen": {
      "type": "string"
    },
    "viewport": {
      "type": "string"
    },
    "touch": {
      "type": "boolean"
    },
    "user_agent": {
      "type": "string"
    },
    "browser": {
      "type": [
        "string",
        "null"
      ]
    },
    "browser_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "os": {
      "type": [
        "string",
        "null"
      ]
    },
    "device_type": {
      "anyOf": [
        {
          "$ref": "#/$defs/DeviceType"
        },
        {
          "type": "null"
        }
      ]
    },
    "connection": {
      "type": [
        "string",
        "null"
      ]
    },
    "color_scheme": {
      "anyOf": [
        {
          "$ref": "#/$defs/ColorScheme"
        },
        {
          "type": "null"
        }
      ]
    },
    "utm_source": {
      "type": [
        "string",
        "null"
      ]
    },
    "utm_medium": {
      "type": [
        "string",
        "null"
      ]
    },
    "utm_campaign": {
      "type": [
        "string",
        "null"
      ]
    },
    "utm_term": {
      "type": [
        "string",
        "null"
      ]
    },
    "utm_content": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_channel": {
      "anyOf": [
        {
          "$ref": "#/$defs/Channel"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "attribution_channel": {
      "anyOf": [
        {
          "$ref": "#/$defs/Channel"
        },
        {
          "type": "null"
        }
      ]
    },
    "attribution_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "attribution_landing": {
      "type": [
        "string",
        "null"
      ]
    },
    "traffic_kind": {
      "anyOf": [
        {
          "$ref": "#/$defs/TrafficKind"
        },
        {
          "type": "null"
        }
      ]
    },
    "traffic_signals": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "fingerprint_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "fingerprint_scrambled": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "fingerprint_reasons": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FingerprintReason"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "props": {
      "$ref": "#/$defs/Props"
    }
  },
  "required": [
    "id",
    "name",
    "time",
    "site",
    "visitor_id",
    "session_id",
    "user_id",
    "page_view_id",
    "url",
    "path",
    "title",
    "referrer",
    "language",
    "timezone",
    "screen",
    "viewport",
    "touch",
    "user_agent",
    "browser",
    "browser_version",
    "os",
    "device_type",
    "connection",
    "color_scheme",
    "utm_source",
    "utm_medium",
    "utm_campaign",
    "utm_term",
    "utm_content",
    "source_channel",
    "source_name",
    "attribution_channel",
    "attribution_name",
    "attribution_landing",
    "traffic_kind",
    "traffic_signals",
    "fingerprint_id",
    "fingerprint_scrambled",
    "fingerprint_reasons",
    "props"
  ],
  "description": "One event as a flat snake_case row, matching schema/postgres.sql column for column.",
  "additionalProperties": false,
  "$defs": {
    "DeviceType": {
      "type": "string",
      "enum": [
        "mobile",
        "tablet",
        "desktop"
      ]
    },
    "ColorScheme": {
      "type": "string",
      "enum": [
        "light",
        "dark"
      ]
    },
    "Channel": {
      "type": "string",
      "enum": [
        "direct",
        "internal",
        "search",
        "social",
        "ai",
        "email",
        "paid",
        "referral"
      ]
    },
    "TrafficKind": {
      "type": "string",
      "enum": [
        "unknown",
        "human",
        "automated",
        "ai-agent",
        "crawler"
      ]
    },
    "FingerprintReason": {
      "type": "string",
      "enum": [
        "canvas-noise",
        "canvas-unavailable",
        "webgl-unavailable",
        "brave",
        "resist-fingerprinting"
      ],
      "description": "What weakened a fingerprint. canvas-noise: two identical canvas drawings read back differently, so the canvas is left out of the id. canvas-unavailable, webgl-unavailable: the API is missing or blocked. brave: Brave, which adds per-site, per-session noise to canvas and other readings. resist-fingerprinting: Firefox's resistFingerprinting (also Tor and Mullvad Browser), which spoofs the timezone and screen."
    },
    "Props": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "$ref": "#/$defs/Json"
          },
          {
            "not": {}
          }
        ]
      }
    },
    "Json": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Json"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Json"
          }
        }
      ],
      "description": "Any JSON-serialisable value."
    }
  }
}
