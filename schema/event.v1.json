{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:analy:schema:event:v1",
  "title": "analy event v1",
  "type": "object",
  "properties": {
    "schema": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "description": "Unique per event: dedupe on it, since a retried batch can arrive more than once.",
      "format": "uuid"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "time": {
      "type": "string",
      "description": "ISO 8601, from the visitor's clock.",
      "format": "date-time"
    },
    "site": {
      "type": "string"
    },
    "visitor": {
      "type": "string",
      "description": "Returning-visitor id. Present when persist is 'local' (the default) or 'cookie' (a uuid), or when the site passed its own visitorId (any string)."
    },
    "session": {
      "type": "string",
      "format": "uuid"
    },
    "user": {
      "type": "string",
      "description": "Set by identify()."
    },
    "page": {
      "$ref": "#/$defs/PageContext"
    },
    "device": {
      "$ref": "#/$defs/DeviceContext"
    },
    "utm": {
      "$ref": "#/$defs/Utm"
    },
    "source": {
      "$ref": "#/$defs/Source"
    },
    "attribution": {
      "$ref": "#/$defs/Attribution",
      "description": "Where this session started; set by the channels plugin."
    },
    "traffic": {
      "$ref": "#/$defs/Traffic"
    },
    "fingerprint": {
      "$ref": "#/$defs/Fingerprint",
      "description": "Device fingerprint; set by the fingerprint plugin."
    },
    "props": {
      "$ref": "#/$defs/Props"
    }
  },
  "required": [
    "schema",
    "id",
    "name",
    "time",
    "session",
    "page",
    "device",
    "props"
  ],
  "description": "One event as sent by the http and callback sinks. Built-in event names carry the props in src/events.ts.",
  "allOf": [
    {
      "if": {
        "properties": {
          "name": {
            "const": "engagement"
          }
        },
        "required": [
          "name"
        ]
      },
      "then": {
        "properties": {
          "props": {
            "$ref": "#/$defs/EngagementProps"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "name": {
            "const": "section_view"
          }
        },
        "required": [
          "name"
        ]
      },
      "then": {
        "properties": {
          "props": {
            "$ref": "#/$defs/SectionViewProps"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "name": {
            "const": "outbound"
          }
        },
        "required": [
          "name"
        ]
      },
      "then": {
        "properties": {
          "props": {
            "$ref": "#/$defs/LinkProps"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "name": {
            "const": "download"
          }
        },
        "required": [
          "name"
        ]
      },
      "then": {
        "properties": {
          "props": {
            "$ref": "#/$defs/DownloadProps"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "name": {
            "const": "contact"
          }
        },
        "required": [
          "name"
        ]
      },
      "then": {
        "properties": {
          "props": {
            "$ref": "#/$defs/ContactProps"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "name": {
            "const": "form_abandon"
          }
        },
        "required": [
          "name"
        ]
      },
      "then": {
        "properties": {
          "props": {
            "$ref": "#/$defs/FormAbandonProps"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "name": {
            "const": "form_snapshot"
          }
        },
        "required": [
          "name"
        ]
      },
      "then": {
        "properties": {
          "props": {
            "$ref": "#/$defs/FormSnapshotProps"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "name": {
            "const": "form_progress"
          }
        },
        "required": [
          "name"
        ]
      },
      "then": {
        "properties": {
          "props": {
            "$ref": "#/$defs/FormProgressProps"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "name": {
            "const": "form_error"
          }
        },
        "required": [
          "name"
        ]
      },
      "then": {
        "properties": {
          "props": {
            "$ref": "#/$defs/FormErrorProps"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "name": {
            "const": "rage_click"
          }
        },
        "required": [
          "name"
        ]
      },
      "then": {
        "properties": {
          "props": {
            "$ref": "#/$defs/RageClickProps"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "name": {
            "const": "dead_click"
          }
        },
        "required": [
          "name"
        ]
      },
      "then": {
        "properties": {
          "props": {
            "$ref": "#/$defs/DeadClickProps"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "name": {
            "const": "heatmap_click"
          }
        },
        "required": [
          "name"
        ]
      },
      "then": {
        "properties": {
          "props": {
            "$ref": "#/$defs/HeatmapClickProps"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "name": {
            "const": "error"
          }
        },
        "required": [
          "name"
        ]
      },
      "then": {
        "properties": {
          "props": {
            "$ref": "#/$defs/ErrorProps"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "name": {
            "const": "vitals"
          }
        },
        "required": [
          "name"
        ]
      },
      "then": {
        "properties": {
          "props": {
            "$ref": "#/$defs/VitalsProps"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "name": {
            "const": "turnstile"
          }
        },
        "required": [
          "name"
        ]
      },
      "then": {
        "properties": {
          "props": {
            "$ref": "#/$defs/TurnstileProps"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "name": {
            "const": "cloudflare"
          }
        },
        "required": [
          "name"
        ]
      },
      "then": {
        "properties": {
          "props": {
            "$ref": "#/$defs/CloudflareProps"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "name": {
            "const": "media"
          }
        },
        "required": [
          "name"
        ]
      },
      "then": {
        "properties": {
          "props": {
            "$ref": "#/$defs/MediaProps"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "name": {
            "const": "search"
          }
        },
        "required": [
          "name"
        ]
      },
      "then": {
        "properties": {
          "props": {
            "$ref": "#/$defs/SearchProps"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "name": {
            "const": "funnel_step"
          }
        },
        "required": [
          "name"
        ]
      },
      "then": {
        "properties": {
          "props": {
            "$ref": "#/$defs/FunnelStepProps"
          }
        }
      }
    }
  ],
  "$defs": {
    "PageContext": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "referrer": {
          "type": "string",
          "description": "External referrer, or the previous page after an SPA navigation."
        },
        "viewId": {
          "type": "string",
          "description": "Shared by every event fired during one page view. SPA route changes start a new one.",
          "format": "uuid"
        }
      },
      "required": [
        "url",
        "path",
        "title",
        "viewId"
      ]
    },
    "DeviceContext": {
      "type": "object",
      "properties": {
        "language": {
          "type": "string"
        },
        "timezone": {
          "type": "string"
        },
        "screen": {
          "type": "string"
        },
        "viewport": {
          "type": "string"
        },
        "touch": {
          "type": "boolean"
        },
        "userAgent": {
          "type": "string"
        },
        "browser": {
          "type": "string",
          "description": "browser … colorScheme are added by the device plugin."
        },
        "browserVersion": {
          "type": "string",
          "description": "Major version only."
        },
        "os": {
          "type": "string"
        },
        "deviceType": {
          "$ref": "#/$defs/DeviceType"
        },
        "connection": {
          "type": "string",
          "description": "Network Information API effectiveType (Chromium only), e.g. \"4g\"."
        },
        "colorScheme": {
          "$ref": "#/$defs/ColorScheme"
        }
      },
      "required": [
        "language",
        "timezone",
        "screen",
        "viewport",
        "touch",
        "userAgent"
      ]
    },
    "DeviceType": {
      "type": "string",
      "enum": [
        "mobile",
        "tablet",
        "desktop"
      ]
    },
    "ColorScheme": {
      "type": "string",
      "enum": [
        "light",
        "dark"
      ]
    },
    "Utm": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string"
        },
        "medium": {
          "type": "string"
        },
        "campaign": {
          "type": "string"
        },
        "term": {
          "type": "string"
        },
        "content": {
          "type": "string"
        }
      }
    },
    "Source": {
      "type": "object",
      "properties": {
        "channel": {
          "$ref": "#/$defs/Channel"
        },
        "name": {
          "type": "string",
          "description": "utm_source if set, else the referrer's host. Empty for direct visits."
        }
      },
      "required": [
        "channel",
        "name"
      ],
      "description": "Added to page views by the channels plugin."
    },
    "Channel": {
      "type": "string",
      "enum": [
        "direct",
        "internal",
        "search",
        "social",
        "ai",
        "email",
        "paid",
        "referral"
      ]
    },
    "Attribution": {
      "type": "object",
      "properties": {
        "channel": {
          "$ref": "#/$defs/Channel"
        },
        "name": {
          "type": "string",
          "description": "As in Source: utm_source if set, else the referrer's host. Empty for direct visits."
        },
        "landing": {
          "type": "string",
          "description": "Path of the session's first page."
        },
        "utm": {
          "$ref": "#/$defs/Utm"
        }
      },
      "required": [
        "channel",
        "name",
        "landing"
      ],
      "description": "Added to every event by the channels plugin: where its session started."
    },
    "Traffic": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/TrafficKind"
        },
        "signals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "kind",
        "signals"
      ]
    },
    "TrafficKind": {
      "type": "string",
      "enum": [
        "unknown",
        "human",
        "automated",
        "ai-agent",
        "crawler"
      ]
    },
    "Fingerprint": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "128-bit hash of the canvas rendering, WebGL renderer, installed fonts, screen, hardware, timezone, languages and platform, as 32 hex characters. The same browser on the same device gives the same id on every page load, in every tab and after its storage is cleared.",
          "pattern": "^[0-9a-f]{32}$"
        },
        "scrambled": {
          "type": "boolean",
          "description": "True when the browser adds noise or spoofs values to resist fingerprinting (reason canvas-noise, brave or resist-fingerprinting): the id may change between visits, so do not use it to link them."
        },
        "reasons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FingerprintReason"
          },
          "description": "Everything that weakened the id. canvas-unavailable and webgl-unavailable leave it stable, only less unique."
        }
      },
      "required": [
        "id",
        "scrambled",
        "reasons"
      ],
      "description": "Added to every event by the fingerprint plugin: a hash of what the browser reveals about the device."
    },
    "FingerprintReason": {
      "type": "string",
      "enum": [
        "canvas-noise",
        "canvas-unavailable",
        "webgl-unavailable",
        "brave",
        "resist-fingerprinting"
      ],
      "description": "What weakened a fingerprint. canvas-noise: two identical canvas drawings read back differently, so the canvas is left out of the id. canvas-unavailable, webgl-unavailable: the API is missing or blocked. brave: Brave, which adds per-site, per-session noise to canvas and other readings. resist-fingerprinting: Firefox's resistFingerprinting (also Tor and Mullvad Browser), which spoofs the timezone and screen."
    },
    "Props": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "$ref": "#/$defs/Json"
          },
          {
            "not": {}
          }
        ]
      }
    },
    "Json": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Json"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Json"
          }
        }
      ],
      "description": "Any JSON-serialisable value."
    },
    "EngagementProps": {
      "type": "object",
      "properties": {
        "activeMs": {
          "type": "integer",
          "description": "Active ms since the last engagement event for this viewId; sum per viewId.",
          "minimum": 1
        },
        "scrollDepth": {
          "type": "integer",
          "description": "Deepest scroll so far, as a percentage of the page.",
          "minimum": 0,
          "maximum": 100
        }
      },
      "required": [
        "activeMs",
        "scrollDepth"
      ],
      "description": "engagement: one report per page view each time it is hidden or left."
    },
    "SectionViewProps": {
      "type": "object",
      "properties": {
        "section": {
          "type": "string",
          "description": "The data-analy-view value, e.g. pricing.",
          "minLength": 1
        },
        "timeToViewMs": {
          "type": "integer",
          "description": "Ms from the start of the page view until the section counted as seen, its visible time included.",
          "minimum": 0
        }
      },
      "required": [
        "section",
        "timeToViewMs"
      ],
      "description": "section_view: a data-analy-view section seen for the first time in a page view."
    },
    "LinkProps": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "description": "outbound: a click on a link to another host."
    },
    "DownloadProps": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        },
        "file": {
          "type": "string"
        }
      },
      "required": [
        "url",
        "file"
      ],
      "description": "download: a click on a file link (by extension or the download attribute)."
    },
    "ContactProps": {
      "type": "object",
      "properties": {
        "channel": {
          "type": "string",
          "enum": [
            "email",
            "phone"
          ]
        },
        "address": {
          "type": "string",
          "description": "The email address or phone number. Removed by the redact plugin."
        }
      },
      "required": [
        "channel"
      ],
      "description": "contact: a click on a mailto: or tel: link."
    },
    "FormAbandonProps": {
      "type": "object",
      "properties": {
        "form": {
          "type": "string",
          "description": "data-analy, id or name of the form."
        },
        "fieldsTouched": {
          "type": "integer",
          "minimum": 1
        },
        "lastField": {
          "type": "string"
        },
        "values": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Field values by name. Removed by the redact plugin."
        },
        "completion": {
          "type": [
            "integer",
            "null"
          ],
          "description": "filled / total as a whole percentage. Null when the form has no named fields to count.",
          "minimum": 0,
          "maximum": 100
        },
        "msInForm": {
          "type": "integer",
          "description": "Ms from the visitor's first focus or input in the form until now.",
          "minimum": 0
        }
      },
      "required": [
        "form",
        "fieldsTouched",
        "lastField",
        "completion",
        "msInForm"
      ],
      "description": "form_abandon: a form the visitor started but left without submitting."
    },
    "FormSnapshotProps": {
      "type": "object",
      "properties": {
        "filled": {
          "type": "integer",
          "description": "Counted fields that hold a value now.",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "description": "Fields the form counts: named and enabled, not hidden inputs or buttons; a radio group or checkboxes sharing a name count once.",
          "minimum": 0
        },
        "form": {
          "type": "string",
          "description": "data-analy, id or name of the form."
        },
        "fieldsTouched": {
          "type": "integer",
          "minimum": 1
        },
        "lastField": {
          "type": "string"
        },
        "values": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Field values by name. Removed by the redact plugin."
        },
        "completion": {
          "type": [
            "integer",
            "null"
          ],
          "description": "filled / total as a whole percentage. Null when the form has no named fields to count.",
          "minimum": 0,
          "maximum": 100
        },
        "msInForm": {
          "type": "integer",
          "description": "Ms from the visitor's first focus or input in the form until now.",
          "minimum": 0
        }
      },
      "required": [
        "completion",
        "fieldsTouched",
        "filled",
        "form",
        "lastField",
        "msInForm",
        "total"
      ],
      "description": "form_snapshot: a started, unsubmitted form's progress when the tab is hidden, sent again only if it changed. Phones often never fire a real unload, so this can be the last word on a form."
    },
    "FormProgressProps": {
      "type": "object",
      "properties": {
        "form": {
          "type": "string",
          "description": "data-analy, id or name of the form."
        },
        "field": {
          "type": "string",
          "description": "The field's name, else its id, else its tag."
        },
        "position": {
          "type": [
            "integer",
            "null"
          ],
          "description": "1-based place of the field among the counted fields. Null for a field the form does not count, such as one without a name.",
          "minimum": 1
        },
        "msOnField": {
          "type": "integer",
          "description": "Ms from focusing the field to finishing it; 0 when it changed without being focused.",
          "minimum": 0
        },
        "value": {
          "type": "string",
          "description": "What the field holds now: a file input's file names, a checkbox or radio's value while checked, else ''. Removed by the redact plugin."
        },
        "filled": {
          "type": "integer",
          "description": "Counted fields that hold a value now.",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "description": "Fields the form counts: named and enabled, not hidden inputs or buttons; a radio group or checkboxes sharing a name count once.",
          "minimum": 0
        }
      },
      "required": [
        "field",
        "filled",
        "form",
        "msOnField",
        "position",
        "total"
      ],
      "description": "form_progress: the visitor finished a field: changed it, or left it changed."
    },
    "FormErrorProps": {
      "type": "object",
      "properties": {
        "form": {
          "type": "string",
          "description": "data-analy, id or name of the form."
        },
        "field": {
          "type": "string",
          "description": "The field's name, else its id, else its tag."
        },
        "reason": {
          "type": "string",
          "enum": [
            "valueMissing",
            "typeMismatch",
            "patternMismatch",
            "tooShort",
            "tooLong",
            "rangeUnderflow",
            "rangeOverflow",
            "stepMismatch",
            "badInput",
            "customError"
          ],
          "description": "The first failing ValidityState check."
        },
        "message": {
          "type": "string",
          "description": "The browser's validationMessage, in the visitor's language. Chrome quotes what was typed, so the redact plugin removes it."
        }
      },
      "required": [
        "form",
        "field",
        "reason"
      ],
      "description": "form_error: the browser refused a field's value (its invalid event), once per field per attempt."
    },
    "RageClickProps": {
      "type": "object",
      "properties": {
        "element": {
          "type": [
            "string",
            "null"
          ]
        },
        "clicks": {
          "type": "integer",
          "minimum": 2
        }
      },
      "required": [
        "element",
        "clicks"
      ],
      "description": "rage_click: repeated clicks on one spot."
    },
    "DeadClickProps": {
      "type": "object",
      "properties": {
        "element": {
          "type": "string",
          "description": "The actionable element clicked, e.g. button#buy.btn."
        },
        "disabled": {
          "type": "boolean",
          "description": "It was disabled or aria-disabled=\"true\": the visitor tried to use it anyway."
        }
      },
      "required": [
        "element",
        "disabled"
      ],
      "description": "dead_click: a click on something that looks actionable, after which nothing happened."
    },
    "HeatmapClickProps": {
      "type": "object",
      "properties": {
        "element": {
          "type": "string"
        },
        "x": {
          "type": "integer"
        },
        "y": {
          "type": "integer"
        },
        "pageWidth": {
          "type": "integer"
        },
        "pageHeight": {
          "type": "integer"
        },
        "elementX": {
          "type": [
            "number",
            "null"
          ],
          "description": "Position inside the element, 0–1. Null for zero-size elements."
        },
        "elementY": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "element",
        "x",
        "y",
        "pageWidth",
        "pageHeight",
        "elementX",
        "elementY"
      ],
      "description": "heatmap_click: every click, with page and in-element position."
    },
    "ErrorProps": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "error",
            "unhandledrejection"
          ]
        },
        "message": {
          "type": "string"
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        },
        "line": {
          "type": [
            "number",
            "null"
          ]
        },
        "column": {
          "type": [
            "number",
            "null"
          ]
        },
        "stack": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "message",
        "stack"
      ],
      "description": "error: an uncaught error or unhandled promise rejection."
    },
    "VitalsProps": {
      "type": "object",
      "properties": {
        "lcp": {
          "type": "integer"
        },
        "fcp": {
          "type": "integer"
        },
        "inp": {
          "type": "integer"
        },
        "ttfb": {
          "type": "integer"
        },
        "cls": {
          "type": "number",
          "description": "Unitless, 4 decimal places."
        }
      },
      "description": "vitals: Core Web Vitals; keep the last one per viewId. Missing metrics are omitted."
    },
    "TurnstileProps": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "shown",
            "clicked",
            "solved",
            "expired"
          ],
          "description": "clicked means the visitor had to click: an interactive challenge. solved means a token was issued."
        },
        "widget": {
          "type": "string",
          "description": "The widget's container, e.g. div#signup-check."
        },
        "ms": {
          "type": "integer",
          "description": "solved only: ms since the widget appeared."
        }
      },
      "required": [
        "status",
        "widget"
      ],
      "description": "turnstile: what happened to a Cloudflare Turnstile widget."
    },
    "CloudflareProps": {
      "type": "object",
      "properties": {
        "colo": {
          "type": "string",
          "description": "Data centre that served the visitor, e.g. LHR."
        },
        "country": {
          "type": "string",
          "description": "ISO country code (trace field loc)."
        },
        "ip": {
          "type": "string",
          "description": "Removed by the redact plugin."
        },
        "http": {
          "type": "string"
        },
        "tls": {
          "type": "string"
        },
        "warp": {
          "type": "string",
          "description": "on when the visitor uses Cloudflare WARP."
        },
        "clearance": {
          "type": "boolean",
          "const": true,
          "description": "The cf_clearance cookie was readable: a Cloudflare challenge was passed recently."
        }
      },
      "required": [
        "colo"
      ],
      "description": "cloudflare: Cloudflare's view of the visitor from /cdn-cgi/trace, once per session."
    },
    "MediaProps": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "play",
            "pause",
            "progress",
            "complete",
            "stop",
            "error"
          ],
          "description": "stop: the page was left while it was still playing."
        },
        "kind": {
          "type": "string",
          "enum": [
            "video",
            "audio"
          ]
        },
        "provider": {
          "type": "string",
          "enum": [
            "youtube",
            "vimeo"
          ],
          "description": "Embedded players only (the embeds plugin): whose iframe player it is. Absent for <video> and <audio>."
        },
        "media": {
          "type": "string",
          "description": "data-analy, id, or the file name of the source (for an embed, the provider's video id)."
        },
        "src": {
          "type": "string",
          "description": "The media URL; for an embed, the iframe's src."
        },
        "position": {
          "type": "number",
          "description": "Seconds into the media."
        },
        "duration": {
          "type": [
            "number",
            "null"
          ],
          "description": "Seconds; null for live streams and before the browser (or the embedded player) has reported it."
        },
        "muted": {
          "type": "boolean"
        },
        "watchedSeconds": {
          "type": "number",
          "description": "Seconds actually played in this page view so far, seeking excluded. Keep the largest per media and viewId."
        },
        "percent": {
          "type": "integer",
          "description": "progress: the milestone reached; complete: 100."
        },
        "code": {
          "type": [
            "number",
            "null"
          ],
          "description": "error only: the MediaError code, 1–4."
        }
      },
      "required": [
        "action",
        "kind",
        "media",
        "src",
        "position",
        "duration",
        "muted",
        "watchedSeconds"
      ],
      "description": "media: what happened to a <video> or <audio> element, or to an embedded YouTube or Vimeo player."
    },
    "SearchProps": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "The search terms, trimmed. Emails in them are removed by the redact plugin."
        },
        "param": {
          "type": "string",
          "description": "The URL param the query came in, e.g. q."
        },
        "results": {
          "type": "integer",
          "description": "The number in the page's data-analy-results attribute; absent when there is none.",
          "minimum": 0
        }
      },
      "required": [
        "query",
        "param"
      ],
      "description": "search: a page view whose URL carries a site-search query."
    },
    "FunnelStepProps": {
      "type": "object",
      "properties": {
        "funnel": {
          "type": "string",
          "description": "The funnel's name, as declared."
        },
        "step": {
          "type": "integer",
          "description": "1-based place of the step in the funnel.",
          "minimum": 1
        },
        "stepName": {
          "type": "string",
          "description": "The step as declared: a path such as /pricing, or an event name."
        },
        "steps": {
          "type": "integer",
          "description": "How many steps the funnel has.",
          "minimum": 1
        },
        "skipped": {
          "type": "integer",
          "description": "Steps passed over on the way here: 0 when this step follows the one reached before.",
          "minimum": 0
        },
        "completed": {
          "type": "boolean",
          "description": "This is the last step. The session's progress is cleared, so it can enter the funnel again."
        },
        "msSinceStart": {
          "type": "integer",
          "description": "Ms since the session reached its first step of this pass through the funnel; 0 on that step.",
          "minimum": 0
        },
        "msSincePrevious": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Ms since the step reached before this one. Null on the first step of a pass.",
          "minimum": 0
        }
      },
      "required": [
        "funnel",
        "step",
        "stepName",
        "steps",
        "skipped",
        "completed",
        "msSinceStart",
        "msSincePrevious"
      ],
      "description": "funnel_step: a session reached a step of a declared funnel beyond the furthest step it had reached so far. Steps at or before that one send nothing."
    }
  }
}
